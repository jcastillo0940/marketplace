{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run verify:route-chunks",
    "test": "vitest run",
    "test:route-chunks": "node --test scripts/verify-route-chunks.test.mjs",
    "verify:route-chunks": "node scripts/verify-route-chunks.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:openapi": "node scripts/verify-openapi.mjs",
    "lint:design": "designmd lint ../DESIGN.md",
    "verify:design": "npm run lint:design && node scripts/verify-design-tokens.mjs --design ../DESIGN.md"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
